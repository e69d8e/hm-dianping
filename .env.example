# ==========================================
# 黑马点评 (hm-dianping) 环境变量配置文件模板
# 使用方法：
# 1. 复制本文件重命名为 .env : cp .env.example .env
# 2. 根据本地环境修改对应配置项
# ==========================================

# -----------------
# 服务配置
# -----------------
SERVER_PORT=8081

# -----------------
# MySQL 数据库配置
# -----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=hmdp
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# -----------------
# Redis 缓存与消息队列配置
# -----------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 若 Redis 无密码请留空
REDIS_PASSWORD=
