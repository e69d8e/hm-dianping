  "cards": [
    {
      "dot": "emerald",
      "title": "⚡ 核心秒杀主链路 (Highlighted Path)",
      "items": [
        "客户端请求经 Nginx 反向代理至 Spring Boot 应用层",
        "双拦截器校验 Token 并存入 ThreadLocal (UserHolder)",
        "Service 执行 seckill.lua 原子校验库存与一人一单并推入 Stream 队列",
        "StreamConsumer 线程池异步消费订单落库 MySQL 并 ACK"
      ]
    },
    {
      "dot": "cyan",
      "title": "🛡️ 外部依赖与信任边界 (Boundaries)",
      "items": [
        "外部接入层 (Client)：公网访问 Nginx 静态资源及反向代理接口",
        "应用服务区 (Trusted Cluster)：内部共享 ThreadLocal 认证上下文",
        "数据私网区 (Internal Storage)：Redis 6.0+ 与 MySQL 8.0 仅内网开放"
      ]
    },
    {
      "dot": "amber",
      "title": "📦 缓存治理与并发保护 (Governance)",
      "items": [
        "CacheClient 封装防穿透空值缓存与防击穿逻辑过期机制",
        "Redisson 分布式锁看门狗机制防止锁误释放与并发超卖",
        "Redis Stream Pending-List 自愈消费者应对异常与漏单"
      ]
    }
  ]
